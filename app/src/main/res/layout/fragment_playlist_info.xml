<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.library.info_playlist.PlaylistInfoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6E8EB"
        >

        <ImageView
            android:id="@+id/image_playlist"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/place_holder_cover"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:id="@+id/info_playlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/image_playlist">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Best songs 2021"
                android:textSize="24sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_title_dark"
                android:fontFamily="@font/ys_display_bold"
                />
            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="2022"
                android:textSize="18sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_title_dark"
                android:fontFamily="@font/ys_display_regular"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/playlist_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_display_regular"
                    android:text="300 минут"
                    android:textColor="@color/color_title_dark"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="@dimen/item_track_search_image_point"
                    android:layout_height="@dimen/item_track_search_image_point"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/playlist_time"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/point_ic"/>
                <TextView
                    android:id="@+id/playlist_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="98 треков"
                    android:textSize="18sp"
                    android:textColor="@color/color_title_dark"
                    android:fontFamily="@font/ys_display_regular"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/imageView"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/share" />
                <ImageView
                    android:id="@+id/more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:src="@drawable/more" />
            </LinearLayout>

        </LinearLayout>


        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_playlist_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_btn_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="false"
        app:behavior_peekHeight="170dp"
        android:background="@drawable/sheet_playlist"
        >
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="#E6E8EB" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_tracks"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
