<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/mediaLibraryFragment"
    android:id="@+id/main_navigation_graph">
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.practicum.playlistmaker.ui.search.fragment.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_audioPlayerActivity"
            app:destination="@id/audioPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.practicum.playlistmaker.ui.setting.fragment.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/audioPlayerFragment"
        android:name="com.practicum.playlistmaker.ui.audioplayer.fragment.AudioPlayerFragment"
        android:label="activity_audio_player"
        tools:layout="@layout/fragment_audio_player" >
        <action
            android:id="@+id/action_audioPlayerFragment_to_addNewPlayListFragment"
            app:destination="@id/addNewPlayListFragment" />
        <argument
            android:name="track"
            app:argType="com.practicum.playlistmaker.domain.models.Track" />
    </fragment>
    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.practicum.playlistmaker.ui.library.fragments.MediaLibraryFragment"
        android:label="fragment_medialibrary"
        tools:layout="@layout/fragment_medialibrary" >
        <action
            android:id="@+id/action_mediaLibraryFragment_to_addNewPlayListFragment"
            app:destination="@id/addNewPlayListFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_audioPlayerFragment"
            app:destination="@id/audioPlayerFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_playlistInfo"
            app:destination="@id/playlistInfo" />
    </fragment>
    <fragment
        android:id="@+id/addNewPlayListFragment"
        android:name="com.practicum.playlistmaker.ui.library.add_playlist.fragment.AddNewPlayListFragment"
        android:label="AddNewPlayListFragment"
        tools:layout="@layout/fragment_add_new_playlist"
        />
    <fragment
        android:id="@+id/playlistInfo"
        android:name="com.practicum.playlistmaker.ui.library.info_playlist.PlaylistInfo"
        android:label="fragment_playlist_info"
        tools:layout="@layout/fragment_playlist_info"
        >
        <argument
            android:name="item"
            app:argType="com.practicum.playlistmaker.ui.library.playlist.models.PlaylistItem" />
    </fragment>

</navigation>